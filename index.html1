<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Sentence Builder</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      padding: 18px;
      font-family: Arial, sans-serif;
      color: #243247;
      background: #f2f6fb;
    }

    h1, h2 {
      text-align: center;
    }

    .tabs,
    .button-row {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .tabs {
      justify-content: center;
      margin-bottom: 18px;
    }

    .panel,
    .card,
    .exercise {
      max-width: 760px;
      margin: 14px auto;
      padding: 16px;
      background: white;
      border-radius: 12px;
      box-shadow: 0 2px 8px #00000012;
    }

    label {
      display: block;
      margin: 12px 0 5px;
      font-weight: bold;
    }

    input,
    select,
    textarea {
      width: 100%;
      padding: 10px;
      border: 1px solid #cbd5e1;
      border-radius: 6px;
      font: inherit;
    }

    textarea {
      min-height: 80px;
      resize: vertical;
    }

    button {
      margin-top: 9px;
      padding: 10px 14px;
      border: 0;
      border-radius: 6px;
      color: white;
      background: #2879c7;
      font: inherit;
      cursor: pointer;
    }

    button:hover {
      background: #1d65a8;
    }

    button.secondary {
      background: #64748b;
    }

    button.danger {
      background: #b9382b;
    }

    .hidden {
      display: none !important;
    }

    .word {
      display: inline-block;
      margin: 5px;
      padding: 8px 12px;
      border-radius: 6px;
      background: #3498db;
      color: white;
      cursor: pointer;
      user-select: none;
    }

    .word:hover {
      background: #217db8;
    }

    .sentence {
      min-height: 48px;
      padding: 6px;
      margin: 12px 0;
      border-bottom: 2px dashed #94a3b8;
    }

    .result {
      min-height: 24px;
      margin-top: 8px;
      font-weight: bold;
      line-height: 1.5;
    }

    .muted {
      color: #64748b;
    }

    .admin-item {
      padding: 12px 0;
      border-bottom: 1px solid #e2e8f0;
    }

    .admin-item:last-child {
      border-bottom: 0;
    }

    .admin-item textarea,
    .admin-item select {
      margin-bottom: 4px;
    }

    #jsonOutput {
      min-height: 240px;
      font-family: monospace;
    }

    @media (max-width: 600px) {
      body {
        padding: 10px;
      }
    }
  </style>
</head>

<body>
  <h1>Sentence Builder</h1>

  <div class="tabs">
    <button id="studentTab" type="button">Gra</button>
    <button id="adminTab" type="button" class="secondary">
      Panel administratora
    </button>
  </div>

  <main>
    <section id="studentPanel" class="panel">
      <div class="card">
        <h2>Ustawienia gry</h2>

        <label for="categoryFilter">Kategoria zdań</label>
        <select id="categoryFilter"></select>

        <label for="playerCount">Liczba graczy</label>
        <input id="playerCount" type="number" min="1" value="1">

        <label for="playerNames">
          Imiona graczy — wpisz po przecinku (opcjonalnie)
        </label>
        <input
          id="playerNames"
          type="text"
          placeholder="Anna, Bartek, Kasia"
        >

        <label for="rounds">Liczba zdań na każdego gracza</label>
        <input id="rounds" type="number" min="1" value="5">

        <button id="startGame" type="button">Rozpocznij grę</button>
      </div>

      <div id="gameArea"></div>
      <div id="scoreArea" class="card"></div>
    </section>

    <section id="adminPanel" class="panel hidden">
      <div class="card">
        <h2>Wczytaj plik JSON</h2>
        <p class="muted">
          Umieść pliki <code>index.html</code> i <code>exercises.json</code>
          w tym samym folderze. Jeśli JSON nie wczyta się automatycznie,
          wybierz go poniżej.
        </p>
        <input id="jsonFile" type="file" accept=".json,application/json">
        <div id="loadStatus" class="muted"></div>
      </div>

      <div class="card">
        <h2>Dodaj zdanie</h2>
        <form id="exerciseForm">
          <label for="sentenceInput">Zdanie po angielsku</label>
          <textarea
            id="sentenceInput"
            required
            placeholder="Na przykład: She has already finished her homework."
          ></textarea>

          <label for="categorySelect">Kategoria</label>
          <select id="categorySelect"></select>

          <button type="submit">Dodaj zdanie</button>
        </form>
      </div>

      <div class="card">
        <h2>Dodaj kategorię</h2>
        <form id="categoryForm">
          <label for="newCategory">Nazwa kategorii</label>
          <input
            id="newCategory"
            type="text"
            required
            placeholder="Na przykład: Going to future"
          >
          <button type="submit">Dodaj kategorię</button>
        </form>
      </div>

      <div class="card">
        <h2>Edytuj lub usuń zdania</h2>
        <div id="adminExercises"></div>
      </div>

      <div class="card">
        <h2>Eksport do pliku JSON</h2>
        <p class="muted">
          Po zmianach skopiuj poniższy JSON i wklej go do pliku
          <code>exercises.json</code>, zastępując jego dotychczasową zawartość.
        </p>
        <button id="copyJson" type="button">Skopiuj kod JSON</button>
        <textarea id="jsonOutput" readonly aria-label="Kod JSON"></textarea>
        <div id="copyStatus" class="muted"></div>
      </div>
    </section>
  </main>

  <script>
    const data = {
      categories: [],
      exercises: []
    };

    const $ = id => document.getElementById(id);

    const studentPanel = $("studentPanel");
    const adminPanel = $("adminPanel");

    function showPanel(isAdmin) {
      studentPanel.classList.toggle("hidden", isAdmin);
      adminPanel.classList.toggle("hidden", !isAdmin);

      $("studentTab").classList.toggle("secondary", isAdmin);
      $("adminTab").classList.toggle("secondary", !isAdmin);
    }

    $("studentTab").addEventListener("click", () => showPanel(false));
    $("adminTab").addEventListener("click", () => showPanel(true));

    function validateData(parsed) {
      if (
        !parsed ||
        !Array.isArray(parsed.categories) ||
        !Array.isArray(parsed.exercises)
      ) {
        throw new Error(
          "JSON powinien zawierać tablice categories oraz exercises."
        );
      }

      if (!parsed.categories.every(item => typeof item === "string")) {
        throw new Error("Każda kategoria powinna być tekstem.");
      }

      if (!parsed.exercises.every(item =>
        item &&
        typeof item.sentence === "string" &&
        typeof item.category === "string"
      )) {
        throw new Error(
          "Każde zdanie powinno zawierać pola sentence i category."
        );
      }

      data.categories = parsed.categories;
      data.exercises = parsed.exercises;
      renderAll();
    }

    async function loadDefaultJson() {
      try {
        const response = await fetch("exercises.json");

        if (!response.ok) {
          throw new Error("Nie znaleziono pliku exercises.json.");
        }

        validateData(await response.json());
        $("loadStatus").textContent = "Wczytano exercises.json.";
      } catch (error) {
        $("loadStatus").textContent =
          "Nie udało się wczytać pliku automatycznie. Wybierz exercises.json powyżej.";
      }
    }

    $("jsonFile").addEventListener("change", async event => {
      const file = event.target.files[0];
      if (!file) return;

      try {
        const parsed = JSON.parse(await file.text());
        validateData(parsed);
        $("loadStatus").textContent = "Wczytano wybrany plik JSON.";
      } catch (error) {
        $("loadStatus").textContent = "Błąd pliku: " + error.message;
      }
    });

    function fillSelects() {
      const filter = $("categoryFilter");
      const adminSelect = $("categorySelect");
      const previousFilter = filter.value;

      filter.innerHTML = "";
      adminSelect.innerHTML = "";

      const allOption = document.createElement("option");
      allOption.value = "all";
      allOption.textContent = "Wszystkie kategorie";
      filter.appendChild(allOption);

      data.categories.forEach(category => {
        const filterOption = document.createElement("option");
        filterOption.value = category;
        filterOption.textContent = category;
        filter.appendChild(filterOption);

        const adminOption = document.createElement("option");
        adminOption.value = category;
        adminOption.textContent = category;
        adminSelect.appendChild(adminOption);
      });

      filter.value = data.categories.includes(previousFilter)
        ? previousFilter
        : "all";
    }

    function renderAdminExercises() {
      const box = $("adminExercises");
      box.innerHTML = "";

      if (data.exercises.length === 0) {
        box.textContent = "Brak zdań.";
        return;
      }

      data.exercises.forEach((exercise, index) => {
        const item = document.createElement("div");
        item.className = "admin-item";

        const sentenceInput = document.createElement("textarea");
        sentenceInput.value = exercise.sentence;
        sentenceInput.setAttribute("aria-label", "Edytuj zdanie");

        const categorySelect = document.createElement("select");
        categorySelect.setAttribute("aria-label", "Wybierz kategorię");

        data.categories.forEach(category => {
          const option = document.createElement("option");
          option.value = category;
          option.textContent = category;
          categorySelect.appendChild(option);
        });

        categorySelect.value = exercise.category;

        const saveButton = document.createElement("button");
        saveButton.type = "button";
        saveButton.textContent = "Zapisz zmiany";

        saveButton.addEventListener("click", () => {
          const newSentence = sentenceInput.value.trim();
          const newCategory = categorySelect.value;

          if (!newSentence || !newCategory) {
            alert("Wpisz zdanie i wybierz kategorię.");
            return;
          }

          data.exercises[index].sentence = newSentence;
          data.exercises[index].category = newCategory;
          renderAll();
        });

        const deleteButton = document.createElement("button");
        deleteButton.type = "button";
        deleteButton.className = "danger";
        deleteButton.textContent = "Usuń";

        deleteButton.addEventListener("click", () => {
          data.exercises.splice(index, 1);
          renderAll();
        });

        item.appendChild(sentenceInput);
        item.appendChild(categorySelect);
        item.appendChild(saveButton);
        item.appendChild(deleteButton);
        box.appendChild(item);
      });
    }

    function renderAll() {
      fillSelects();
      renderAdminExercises();
      $("jsonOutput").value = JSON.stringify(data, null, 2);
    }

    $("exerciseForm").addEventListener("submit", event => {
      event.preventDefault();

      const sentence = $("sentenceInput").value.trim();
      const category = $("categorySelect").value;

      if (!sentence || !category) {
        alert("Wpisz zdanie i wybierz kategorię.");
        return;
      }

      data.exercises.push({ category, sentence });
      $("sentenceInput").value = "";
      renderAll();
    });

    $("categoryForm").addEventListener("submit", event => {
      event.preventDefault();

      const category = $("newCategory").value.trim();
      if (!category) return;

      const alreadyExists = data.categories.some(
        item => item.toLowerCase() === category.toLowerCase()
      );

      if (alreadyExists) {
        alert("Taka kategoria już istnieje.");
        return;
      }

      data.categories.push(category);
      $("newCategory").value = "";
      renderAll();
      $("categorySelect").value = category;
    });

    $("copyJson").addEventListener("click", async () => {
      const json = JSON.stringify(data, null, 2);
      $("jsonOutput").value = json;

      try {
        await navigator.clipboard.writeText(json);
        $("copyStatus").textContent = "Skopiowano JSON do schowka.";
      } catch (error) {
        $("jsonOutput").focus();
        $("jsonOutput").select();

        const copied = document.execCommand("copy");
        $("copyStatus").textContent = copied
          ? "Skopiowano JSON do schowka."
          : "Nie udało się skopiować automatycznie. Zaznacz i skopiuj tekst ręcznie.";
      }
    });

    function shuffle(array) {
      const result = [...array];

      for (let i = result.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [result[i], result[j]] = [result[j], result[i]];
      }

      return result;
    }

    let game = null;

    $("startGame").addEventListener("click", () => {
      const selectedCategory = $("categoryFilter").value;

      const availableExercises = data.exercises.filter(exercise =>
        selectedCategory === "all" ||
        exercise.category === selectedCategory
      );

      if (availableExercises.length === 0) {
        alert("W wybranej kategorii nie ma zdań.");
        return;
      }

      const playerCount = Math.max(
        1,
        parseInt($("playerCount").value, 10) || 1
      );

      const roundsPerPlayer = Math.max(
        1,
        parseInt($("rounds").value, 10) || 1
      );

      const enteredNames = $("playerNames").value
        .split(",")
        .map(name => name.trim())
        .filter(Boolean);

      const players = Array.from({ length: playerCount }, (_, index) =>
        enteredNames[index] || "Gracz " + (index + 1)
      );

      const totalTurns = playerCount * roundsPerPlayer;
      const queue = Array.from({ length: totalTurns }, (_, index) =>
        availableExercises[index % availableExercises.length]
      );

      game = {
        players,
        scores: players.map(() => 0),
        queue: shuffle(queue),
        completed: 0,
        solved: false
      };

      showNextExercise();
    });

    function showNextExercise() {
      const area = $("gameArea");

      if (!game) return;

      if (game.completed >= game.queue.length) {
        area.innerHTML = "";

        const highestScore = Math.max(...game.scores);
        const winners = game.players.filter(
          (_, index) => game.scores[index] === highestScore
        );

        const endCard = document.createElement("div");
        endCard.className = "card";

        const heading = document.createElement("h2");
        heading.textContent = "Koniec gry!";

        const winnerText = document.createElement("p");
        winnerText.textContent =
          "Zwycięzca: " + winners.join(", ") + " — " +
          highestScore + (highestScore === 1 ? " punkt." : " punktów.");

        endCard.appendChild(heading);
        endCard.appendChild(winnerText);
        area.appendChild(endCard);

        renderScores();
        return;
      }

      game.solved = false;

      const playerIndex = game.completed % game.players.length;
      const exercise = game.queue[game.completed];

      const correctWords = exercise.sentence.trim()
        .split(/\s+/)
        .map((text, id) => ({ text, id }));

      const shuffledWords = shuffle(correctWords);
      const selectedWords = [];

      area.innerHTML = "";

      const card = document.createElement("div");
      card.className = "exercise";

      const turnHeading = document.createElement("h2");
      turnHeading.textContent = "Teraz gra: " + game.players[playerIndex];

      const categoryLabel = document.createElement("p");
      categoryLabel.className = "muted";
      categoryLabel.textContent = exercise.category;

      const answerArea = document.createElement("div");
      answerArea.className = "sentence";

      const wordBank = document.createElement("div");

      const result = document.createElement("div");
      result.className = "result";

      function updateAnswer() {
        answerArea.innerHTML = "";

        selectedWords.forEach((word, index) => {
          const tile = document.createElement("span");
          tile.className = "word";
          tile.textContent = word.text;
          tile.title = "Kliknij, aby cofnąć wybór";

          tile.addEventListener("click", () => {
            if (game.solved) return;

            const removedWord = selectedWords.splice(index, 1)[0];

            wordBank.querySelectorAll("[data-word-id]").forEach(bankWord => {
              if (Number(bankWord.dataset.wordId) === removedWord.id) {
                bankWord.classList.remove("hidden");
              }
            });

            updateAnswer();
          });

          answerArea.appendChild(tile);
        });
      }

      shuffledWords.forEach(word => {
        const tile = document.createElement("span");
        tile.className = "word";
        tile.textContent = word.text;
        tile.dataset.wordId = word.id;

        tile.addEventListener("click", () => {
          if (game.solved) return;

          selectedWords.push(word);
          tile.classList.add("hidden");
          updateAnswer();
        });

        wordBank.appendChild(tile);
      });

      const checkButton = document.createElement("button");
      checkButton.type = "button";
      checkButton.textContent = "Sprawdź";

      const nextButton = document.createElement("button");
      nextButton.type = "button";
      nextButton.className = "secondary hidden";
      nextButton.textContent = "Następne zdanie";

      checkButton.addEventListener("click", () => {
        if (game.solved) return;

        const userAnswer = selectedWords
          .map(word => word.text)
          .join(" ");

        const correctAnswer = exercise.sentence.trim();

        game.solved = true;

        if (userAnswer === correctAnswer) {
          game.scores[playerIndex] += 1;
          result.textContent = "Poprawnie! +1 punkt.";
          result.style.color = "green";
        } else {
          result.textContent =
            "Błędna odpowiedź — 0 punktów. Poprawne zdanie: " +
            correctAnswer;
          result.style.color = "#b9382b";
        }

        checkButton.classList.add("hidden");
        nextButton.classList.remove("hidden");
        renderScores();
      });

      nextButton.addEventListener("click", () => {
        game.completed += 1;
        showNextExercise();
      });

      card.appendChild(turnHeading);
      card.appendChild(categoryLabel);
      card.appendChild(answerArea);
      card.appendChild(wordBank);
      card.appendChild(checkButton);
      card.appendChild(nextButton);
      card.appendChild(result);

      area.appendChild(card);
      renderScores();
    }

    function renderScores() {
      const scoreArea = $("scoreArea");
      scoreArea.innerHTML = "";

      if (!game) return;

      const heading = document.createElement("h2");
      heading.textContent = "Punkty";
      scoreArea.appendChild(heading);

      game.players.forEach((player, index) => {
        const row = document.createElement("p");
        row.textContent = player + ": " + game.scores[index];
        scoreArea.appendChild(row);
      });
    }

    renderAll();
    loadDefaultJson();
  </script>
</body>
</html>
