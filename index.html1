<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Sentence Builder</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0; padding: 18px; font-family: Arial, sans-serif;
      color: #243247; background: #f2f6fb;
    }
    h1, h2 { text-align: center; }
    .tabs, .row { display: flex; gap: 8px; flex-wrap: wrap; }
    .tabs { justify-content: center; margin-bottom: 18px; }
    .panel, .card, .exercise {
      max-width: 760px; margin: 14px auto; padding: 16px;
      background: white; border-radius: 12px;
      box-shadow: 0 2px 8px #00000012;
    }
    label { display: block; margin: 12px 0 5px; font-weight: bold; }
    input, select, textarea {
      width: 100%; padding: 10px; border: 1px solid #cbd5e1;
      border-radius: 6px; font: inherit;
    }
    textarea { min-height: 80px; resize: vertical; }
    button {
      margin-top: 9px; padding: 10px 14px; border: 0; border-radius: 6px;
      color: white; background: #2879c7; font: inherit; cursor: pointer;
    }
    button:hover { background: #1d65a8; }
    button.secondary { background: #64748b; }
    button.danger { background: #b9382b; }
    .hidden { display: none !important; }
    .word {
      display: inline-block; margin: 5px; padding: 8px 12px;
      border-radius: 6px; background: #3498db; color: white;
      cursor: pointer; user-select: none;
    }
    .word:hover { background: #217db8; }
    .sentence {
      min-height: 48px; padding: 6px; margin: 12px 0;
      border-bottom: 2px dashed #94a3b8;
    }
    .result { min-height: 24px; margin-top: 8px; font-weight: bold; }
    .muted { color: #64748b; }
    .admin-item { padding: 10px 0; border-bottom: 1px solid #e2e8f0; }
    #jsonOutput { min-height: 240px; font-family: monospace; }
    @media (max-width: 600px) { body { padding: 10px; } }
  </style>
</head>
<body>
  <h1>Sentence Builder</h1>

  <div class="tabs">
    <button id="studentTab">Gra</button>
    <button id="adminTab" class="secondary">Panel administratora</button>
  </div>

  <main>
    <section id="studentPanel" class="panel">
      <div class="card">
        <h2>Ustawienia gry</h2>

        <label for="categoryFilter">Kategoria zdań</label>
        <select id="categoryFilter"></select>

        <label for="playerCount">Liczba graczy</label>
        <input id="playerCount" type="number" min="1" value="1">

        <label for="playerNames">Imiona graczy — po przecinku (opcjonalnie)</label>
        <input id="playerNames" type="text" placeholder="Anna, Bartek, Kasia">

        <label for="rounds">Liczba zdań na każdego gracza</label>
        <input id="rounds" type="number" min="1" value="5">

        <button id="startGame" type="button">Rozpocznij grę</button>
      </div>

      <div id="gameArea"></div>
      <div id="scoreArea" class="card"></div>
    </section>

    <section id="adminPanel" class="panel hidden">
      <div class="card">
        <h2>Wczytaj plik JSON</h2>
        <p class="muted">
          Umieść <code>index.html</code> i <code>exercises.json</code> w tym samym
          folderze. Jeśli strona nie wczyta JSON automatycznie, wybierz go tutaj.
        </p>
        <input id="jsonFile" type="file" accept=".json,application/json">
        <div id="loadStatus" class="muted"></div>
      </div>

      <div class="card">
        <h2>Dodaj zdanie</h2>
        <form id="exerciseForm">
          <label for="sentenceInput">Zdanie po angielsku</label>
          <textarea id="sentenceInput" required
            placeholder="Na przykład: She has already finished her homework."></textarea>

          <label for="categorySelect">Kategoria</label>
          <select id="categorySelect"></select>

          <button type="submit">Dodaj zdanie</button>
        </form>
      </div>

      <div class="card">
        <h2>Dodaj kategorię</h2>
        <form id="categoryForm">
          <label for="newCategory">Nazwa kategorii</label>
          <input id="newCategory" required placeholder="Na przykład: Going to future">
          <button type="submit">Dodaj kategorię</button>
        </form>
      </div>

      <div class="card">
        <h2>Zdania w zestawie</h2>
        <div id="adminExercises"></div>
      </div>

      <div class="card">
        <h2>Eksport do pliku JSON</h2>
        <p class="muted">
          Po skopiowaniu wklej cały tekst do pliku <code>exercises.json</code>
          i zapisz go. Zmiany dodane na stronie same nie zapisują się na dysku.
        </p>
        <button id="copyJson" type="button">Skopiuj kod JSON</button>
        <textarea id="jsonOutput" readonly aria-label="Kod JSON"></textarea>
        <div id="copyStatus" class="muted"></div>
      </div>
    </section>
  </main>

<script>
  const data = { categories: [], exercises: [] };

  const $ = id => document.getElementById(id);
  const studentPanel = $("studentPanel");
  const adminPanel = $("adminPanel");

  function showPanel(isAdmin) {
    studentPanel.classList.toggle("hidden", isAdmin);
    adminPanel.classList.toggle("hidden", !isAdmin);
    $("studentTab").classList.toggle("secondary", isAdmin);
    $("adminTab").classList.toggle("secondary", !isAdmin);
  }

  $("studentTab").addEventListener("click", () => showPanel(false));
  $("adminTab").addEventListener("click", () => showPanel(true));

  function validateData(parsed) {
    if (!parsed || !Array.isArray(parsed.categories) ||
        !Array.isArray(parsed.exercises)) {
      throw new Error("JSON powinien zawierać tablice categories i exercises.");
    }
    if (!parsed.categories.every(item => typeof item === "string")) {
      throw new Error("Każda kategoria powinna być tekstem.");
    }
    if (!parsed.exercises.every(item =>
      item && typeof item.sentence === "string" &&
      typeof item.category === "string")) {
      throw new Error("Każde zdanie powinno mieć sentence i category.");
    }
    data.categories = parsed.categories;
    data.exercises = parsed.exercises;
    renderAll();
  }

  async function loadDefaultJson() {
    try {
      const response = await fetch("exercises.json");
      if (!response.ok) throw new Error("Nie znaleziono exercises.json");
      validateData(await response.json());
      $("loadStatus").textContent = "Wczytano exercises.json.";
    } catch (error) {
      $("loadStatus").textContent =
        "Nie udało się wczytać pliku automatycznie. Wybierz exercises.json powyżej.";
    }
  }

  $("jsonFile").addEventListener("change", async event => {
    const file = event.target.files[0];
    if (!file) return;
    try {
      validateData(JSON.parse(await file.text()));
      $("loadStatus").textContent = "Wczytano wybrany plik JSON.";
    } catch (error) {
      $("loadStatus").textContent = "Błąd pliku: " + error.message;
    }
  });

  function fillSelects() {
    const filter = $("categoryFilter");
    const adminSelect = $("categorySelect");
    const previousFilter = filter.value;

    filter.innerHTML = "";
    adminSelect.innerHTML = "";

    const all = document.createElement("option");
    all.value = "all";
    all.textContent = "Wszystkie kategorie";
    filter.appendChild(all);

    data.categories.forEach(category => {
      const option1 = document.createElement("option");
      option1.value = category;
      option1.textContent = category;
      filter.appendChild(option1);

      const option2 = document.createElement("option");
      option2.value = category;
      option2.textContent = category;
      adminSelect.appendChild(option2);
    });

    filter.value = data.categories.includes(previousFilter)
      ? previousFilter : "all";
  }

  function renderAdminExercises() {
    const box = $("adminExercises");
    box.innerHTML = "";

    if (!data.exercises.length) {
      box.textContent = "Brak zdań.";
      return;
    }

    data.exercises.forEach((exercise, index) => {
      const item = document.createElement("div");
      item.className = "admin-item";

      const text = document.createElement("div");
      text.textContent = exercise.category + " — " + exercise.sentence;

      const remove = document.createElement("button");
      remove.type = "button";
      remove.className = "danger";
      remove.textContent = "Usuń";
      remove.addEventListener("click", () => {
        data.exercises.splice(index, 1);
        renderAll();
      });

      item.append(text, remove);
      box.appendChild(item);
    });
  }

  function renderAll() {
    fillSelects();
    renderAdminExercises();
    $("jsonOutput").value = JSON.stringify(data, null, 2);
  }

  $("exerciseForm").addEventListener("submit", event => {
    event.preventDefault();
    const sentence = $("sentenceInput").value.trim();
    const category = $("categorySelect").value;
    if (!sentence || !category) return;

    data.exercises.push({ category, sentence });
    $("sentenceInput").value = "";
    renderAll();
  });

  $("categoryForm").addEventListener("submit", event => {
    event.preventDefault();
    const category = $("newCategory").value.trim();
    if (!category) return;

    if (data.categories.some(item => item.toLowerCase() === category.toLowerCase())) {
      alert("Taka kategoria już istnieje.");
      return;
    }

    data.categories.push(category);
    $("newCategory").value = "";
    renderAll();
    $("categorySelect").value = category;
  });

  $("copyJson").addEventListener("click", async () => {
    const output = $("jsonOutput");
    output.value = JSON.stringify(data, null, 2);

    try {
      await navigator.clipboard.writeText(output.value);
      $("copyStatus").textContent = "Skopiowano JSON do schowka.";
    } catch {
      output.focus();
      output.select();
      document.execCommand("copy");
      $("copyStatus").textContent =
        "Zaznaczony tekst skopiowano. Jeśli kopiowanie nie zadziałało, skopiuj go ręcznie.";
    }
  });

  function shuffle(array) {
    const result = [...array];
    for (let i = result.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [result[i], result[j]] = [result[j], result[i]];
    }
    return result;
  }

  let game = null;

  $("startGame").addEventListener("click", () => {
    const category = $("categoryFilter").value;
    const available = data.exercises.filter(item =>
      category === "all" || item.category === category
    );

    if (!available.length) {
      alert("W wybranej kategorii nie ma zdań.");
      return;
    }

    const count = Math.max(1, parseInt($("playerCount").value, 10) || 1);
    const rounds = Math.max(1, parseInt($("rounds").value, 10) || 1);
    const enteredNames = $("playerNames").value
      .split(",").map(name => name.trim()).filter(Boolean);

    const players = Array.from({ length: count }, (_, i) =>
      enteredNames[i] || "Gracz " + (i + 1)
    );

    const totalTurns = count * rounds;
    const queue = Array.from({ length: totalTurns }, (_, i) =>
      available[i % available.length]
    );

    game = {
      players,
      scores: players.map(() => 0),
      queue: shuffle(queue),
      completed: 0,
      solved: false
    };

    showNextExercise();
  });

  function showNextExercise() {
    const area = $("gameArea");
    const scores = $("scoreArea");

    if (!game || game.completed >= game.queue.length) {
      area.innerHTML = "";
      if (game) {
        const best = Math.max(...game.scores);
        const winners = game.players.filter((_, i) => game.scores[i] === best);
        area.innerHTML = "<div class='card'><h2>Koniec gry!</h2><p>Wynik: " +
          winners.map(escapeHtml).join(", ") + " — " + best + " pkt</p></div>";
        renderScores();
      }
      return;
    }

    game.solved = false;
    const playerIndex = game.completed % game.players.length;
    const exercise = game.queue[game.completed];
    const words = exercise.sentence.trim().split(/\s+/)
      .map((text, id) => ({ text, id }));
    const shuffled = shuffle(words);
    const selected = [];

    area.innerHTML = "";
    const card = document.createElement("div");
    card.className = "exercise";

    const turn = document.createElement("h2");
    turn.textContent = "Teraz gra: " + game.players[playerIndex];

    const category = document.createElement("p");
    category.className = "muted";
    category.textContent = exercise.category;

    const answer = document.createElement("div");
    answer.className = "sentence";

    const bank = document.createElement("div");
    const result = document.createElement("div");
    result.className = "result";

    function drawAnswer() {
      answer.innerHTML = "";
      selected.forEach((word, index) => {
        const tile = document.createElement("span");
        tile.className = "word";
        tile.textContent = word.text;
        tile.title = "Kliknij, aby cofnąć";
        tile.addEventListener("click", () => {
          if (game.solved) return;
          const removed = selected.splice(index, 1)[0];
          bank.querySelectorAll("[data-id]").forEach(el => {
            if (Number(el.dataset.id) === removed.id) el.classList.remove("hidden");
          });
          drawAnswer();
        });
        answer.appendChild(tile);
      });
    }

    shuffled.forEach(word => {
      const tile = document.createElement("span");
      tile.className = "word";
      tile.textContent = word.text;
      tile.dataset.id = word.id;
      tile.addEventListener("click", () => {
        if (game.solved) return;
        selected.push(word);
        tile.classList.add("hidden");
        drawAnswer();
      });
      bank.appendChild(tile);
    });

    const check = document.createElement("button");
    check.type = "button";
    check.textContent = "Sprawdź";
    check.addEventListener("click", () => {
      if (game.solved) return;
      const userAnswer = selected.map(word => word.text).join(" ");
      if (userAnswer === exercise.sentence.trim()) {
        game.solved = true;
        game.scores[playerIndex] += 1;
        result.textContent = "Poprawnie! +1 punkt";
        result.style.color = "green";
        check.classList.add("hidden");
        nextButton.classList.remove("hidden");
        renderScores();
      } else {
        result.textContent = "Jeszcze nie. Spróbuj poprawić kolejność.";
        result.style.color = "#b9382b";
      }
    });

    const nextButton = document.createElement("button");
    nextButton.type = "button";
    nextButton.className = "secondary hidden";
    nextButton.textContent = "Następne zdanie";
    nextButton.addEventListener("click", () => {
      game.completed += 1;
      showNextExercise();
    });

    card.append(turn, category, answer, bank, check, nextButton, result);
    area.appendChild(card);
    renderScores();
  }

  function renderScores() {
    if (!game) return;
    $("scoreArea").innerHTML = "<h2>Punkty</h2>" +
      game.players.map((name, i) =>
        "<p>" + escapeHtml(name) + ": " + game.scores[i] + "</p>"
      ).join("");
  }

  function escapeHtml(text) {
    const div = document.createElement("div");
    div.textContent = text;
    return div.innerHTML;
  }

  renderAll();
  loadDefaultJson();
</script>
</body>
</html>
